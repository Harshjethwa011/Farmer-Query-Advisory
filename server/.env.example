# Required for local persistence and authenticated application use.
MONGODB_URI=mongodb://127.0.0.1:27017/farmer_advisory
JWT_SECRET=

# Optional server settings; defaults shown.
PORT=5000
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
MAX_UPLOAD_MB=5

# Optional disease image provider. The provider must implement the JSON contract in docs/disease-image-provider.md.
DISEASE_PROVIDER=
DISEASE_MODEL=
DISEASE_API_URL=
DISEASE_API_KEY=
DISEASE_TIMEOUT_MS=20000

# Optional: enables the AI assistant when an OpenAI API key is supplied.
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=45000

# Weather uses Open-Meteo for non-commercial use; no API key is required.
